{
    "outputDirectory": "dist",
    "trailingSlash": false,
    "redirects": [
        {
            "source": "/:path*",
            "destination": "https://www.logisaar.in/:path*",
            "permanent": true,
            "has": [
                {
                    "type": "host",
                    "value": "logisaar.in"
                }
            ]
        },
        {
            "source": "/techxera",
            "destination": "/ikuro",
            "permanent": true
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/((?!.*\\.).*)",
            "destination": "/index.html"
        }
    ]
}